<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HealthTrack - คำนวณแคลอรี่</title>

<style>
* {
    box-sizing: border-box;
    font-family: Arial, "Noto Sans Thai", sans-serif;
}

body {
    margin: 0;
    background: #f3f7f5;
    color: #263238;
}

.container {
    width: 100%;
    max-width: 480px;
    margin: auto;
    min-height: 100vh;
    padding: 25px 18px;
}

.card {
    background: white;
    border-radius: 24px;
    padding: 25px;
    box-shadow: 0 8px 30px rgba(0,0,0,.08);
    margin-top: 20px;
}

.center {
    text-align: center;
}

.icon {
    width: 70px;
    height: 70px;
    margin: 30px auto 15px;
    border-radius: 20px;
    background: #dff7e9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 38px;
}

h1 {
    margin-bottom: 8px;
}

.subtitle {
    color: #718096;
    margin-bottom: 30px;
}

button {
    width: 100%;
    border: none;
    border-radius: 14px;
    padding: 15px;
    background: #2e9d62;
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #258452;
}

.hidden {
    display: none;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 7px;
    font-weight: bold;
}

input, select {
    width: 100%;
    padding: 13px;
    border: 1px solid #d7dee3;
    border-radius: 12px;
    font-size: 16px;
    background: white;
}

.result {
    margin-top: 18px;
    padding: 15px;
    border-radius: 15px;
    background: #f4faf6;
}

.result h3 {
    margin-top: 0;
}

.number {
    font-size: 25px;
    font-weight: bold;
    color: #2e9d62;
}

.warning {
    padding: 15px;
    border-radius: 14px;
    margin-top: 15px;
    font-weight: bold;
}

.warning.good {
    background: #e3f7eb;
    color: #176b3b;
}

.warning.low {
    background: #fff3cd;
    color: #856404;
}

.warning.high {
    background: #ffe3e3;
    color: #a52828;
}

.back {
    background: #718096;
    margin-top: 10px;
}
</style>
</head>

<body>

<div class="container">

    <!-- หน้าแรก -->
    <section id="home" class="card center">

        <div class="icon">🔥</div>

        <h1>HealthTrack</h1>

        <p class="subtitle">
            ระบบคำนวณและติดตามแคลอรี่
        </p>

        <button onclick="startApp()">
            เริ่มใช้งาน
        </button>

    </section>


    <!-- หน้ากรอกข้อมูล -->
    <section id="formPage" class="card hidden">

        <h2>ข้อมูลของคุณ</h2>

        <label>เพศ</label>
        <select id="gender">
            <option value="male">ชาย</option>
            <option value="female">หญิง</option>
        </select>

        <label>อายุ (ปี)</label>
        <input
            type="number"
            id="age"
            min="13"
            max="100"
            placeholder="เช่น 20"
        >

        <label>ส่วนสูง (ซม.)</label>
        <input
            type="number"
            id="height"
            min="100"
            max="250"
            placeholder="เช่น 170"
        >

        <label>น้ำหนัก (กก.)</label>
        <input
            type="number"
            id="weight"
            min="20"
            max="300"
            step="0.1"
            placeholder="เช่น 60"
        >

        <label>จำนวนก้าวเดินต่อวัน</label>
        <input
            type="number"
            id="steps"
            min="0"
            placeholder="เช่น 8000"
        >

        <label>ระดับกิจกรรมประจำวัน</label>
        <select id="activity">
            <option value="1.2">
                นั่งเป็นส่วนใหญ่ / ไม่ค่อยออกกำลังกาย
            </option>

            <option value="1.375">
                ออกกำลังกายเบา ๆ 1-3 วัน/สัปดาห์
            </option>

            <option value="1.55">
                ออกกำลังกายปานกลาง 3-5 วัน/สัปดาห์
            </option>

            <option value="1.725">
                ออกกำลังกายหนัก 6-7 วัน/สัปดาห์
            </option>

            <option value="1.9">
                ออกกำลังกายหนักมาก
            </option>
        </select>

        <br><br>

        <button onclick="calculate()">
            🔥 คำนวณแคลอรี่
        </button>

        <button class="back" onclick="goHome()">
            กลับหน้าแรก
        </button>

    </section>


    <!-- หน้าผลลัพธ์ -->
    <section id="resultPage" class="card hidden">

        <h2>📊 ผลการคำนวณ</h2>

        <div class="result">
            <h3>BMR</h3>
            <p>
                พลังงานขั้นต่ำที่ร่างกายใช้ต่อวัน
            </p>

            <div class="number" id="bmr"></div>
        </div>

        <div class="result">
            <h3>TDEE</h3>
            <p>
                พลังงานที่ร่างกายใช้โดยประมาณต่อวัน
            </p>

            <div class="number" id="tdee"></div>
        </div>

        <div class="result">
            <h3>🔥 แคลอรี่จากการเดิน</h3>

            <div class="number" id="walkingCalories"></div>

            <p id="stepText"></p>
        </div>

        <div class="result">
            <h3>🎯 เป้าหมายแคลอรี่</h3>

            <div class="number" id="goal"></div>

            <p id="goalText"></p>
        </div>

        <div class="result">
            <h3>🍽️ การควบคุมอาหาร</h3>

            <p id="foodAdvice"></p>
        </div>

        <div class="result">
            <h3>🏃 การออกกำลังกาย</h3>

            <p id="exerciseAdvice"></p>
        </div>

        <div id="warning"></div>

        <br>

        <button class="back" onclick="goBack()">
            ← คำนวณใหม่
        </button>

    </section>

</div>


<script>

function startApp() {

    document.getElementById("home").classList.add("hidden");

    document.getElementById("formPage").classList.remove("hidden");

}


function goHome() {

    document.getElementById("formPage").classList.add("hidden");

    document.getElementById("home").classList.remove("hidden");

}


function goBack() {

    document.getElementById("resultPage").classList.add("hidden");

    document.getElementById("formPage").classList.remove("hidden");

}


function calculate() {

    const gender =
        document.getElementById("gender").value;

    const age =
        Number(document.getElementById("age").value);

    const height =
        Number(document.getElementById("height").value);

    const weight =
        Number(document.getElementById("weight").value);

    const steps =
        Number(document.getElementById("steps").value);

    const activity =
        Number(document.getElementById("activity").value);


    if (
        !age ||
        !height ||
        !weight ||
        steps < 0
    ) {

        alert("กรุณากรอกข้อมูลให้ครบ");

        return;

    }


    /*
       สูตร Mifflin-St Jeor
       ชาย:
       BMR = 10W + 6.25H - 5A + 5

       หญิง:
       BMR = 10W + 6.25H - 5A - 161
    */

    let bmr;

    if (gender === "male") {

        bmr =
            (10 * weight) +
            (6.25 * height) -
            (5 * age) +
            5;

    } else {

        bmr =
            (10 * weight) +
            (6.25 * height) -
            (5 * age) -
            161;

    }


    /*
       TDEE
       = BMR × Activity Factor
    */

    let tdee = bmr * activity;


    /*
       ประมาณแคลอรี่จากการเดิน

       ระยะทางโดยประมาณ
       = จำนวนก้าว × ความยาวก้าว

       ความยาวก้าวโดยประมาณ
       = ส่วนสูง × 0.413 สำหรับผู้หญิง
       = ส่วนสูง × 0.415 สำหรับผู้ชาย
    */

    let stepLength;

    if (gender === "male") {

        stepLength = height * 0.415;

    } else {

        stepLength = height * 0.413;

    }


    let distance =
        (steps * stepLength) / 100000;


    /*
       ประมาณพลังงานจากการเดิน
    */

    let walkingCalories =
        weight * distance * 0.5;


    /*
       เป้าหมายมาตรฐาน

       ชายประมาณ 2,500 kcal
       หญิงประมาณ 2,000 kcal

       ใช้เป็นค่าอ้างอิงเบื้องต้น
    */

    let standardGoal;

    if (gender === "male") {

        standardGoal = 2500;

    } else {

        standardGoal = 2000;

    }


    /*
       ใช้ TDEE เป็นค่าหลัก
       และไม่ให้เป้าหมายต่ำเกินไป
    */

    let goal =
        Math.round(tdee);


    /*
       แสดงผล
    */

    document.getElementById("bmr").textContent =
        Math.round(bmr) + " kcal/วัน";


    document.getElementById("tdee").textContent =
        Math.round(tdee) + " kcal/วัน";


    document.getElementById("walkingCalories").textContent =
        Math.round(walkingCalories) + " kcal";


    document.getElementById("stepText").textContent =
        "ประมาณ " +
        distance.toFixed(2) +
        " กิโลเมตร จาก " +
        steps.toLocaleString() +
        " ก้าว";


    document.getElementById("goal").textContent =
        goal.toLocaleString() +
        " kcal/วัน";


    document.getElementById("goalText").textContent =
        "ค่าอ้างอิงทั่วไปสำหรับ " +
        (gender === "male" ? "ชาย" : "หญิง") +
        " คือประมาณ " +
        standardGoal.toLocaleString() +
        " kcal/วัน";


    /*
       คำแนะนำอาหาร
    */

    let foodDifference =
        standardGoal - goal;


    if (foodDifference > 0) {

        document.getElementById("foodAdvice").textContent =
            "เป้าหมายของคุณต่ำกว่าค่ามาตรฐานประมาณ " +
            Math.abs(Math.round(foodDifference)) +
            " kcal/วัน ควรเลือกอาหารที่มีคุณค่าทางโภชนาการให้เพียงพอ";

    } else {

        document.getElementById("foodAdvice").textContent =
            "เป้าหมายของคุณสูงกว่าค่ามาตรฐานประมาณ " +
            Math.abs(Math.round(foodDifference)) +
            " kcal/วัน ควรเลือกรับประทานอาหารให้เหมาะกับกิจกรรมของร่างกาย";

    }


    /*
       คำแนะนำการออกกำลังกาย
    */

    let exerciseCalories =
        Math.round(walkingCalories);


    if (steps < 5000) {

        document.getElementById("exerciseAdvice").textContent =
            "จำนวนก้าวค่อนข้างน้อย ลองเพิ่มการเดินหรือกิจกรรมทางกายอย่างค่อยเป็นค่อยไป";

    } else if (steps < 10000) {

        document.getElementById("exerciseAdvice").textContent =
            "ระดับการเดินอยู่ในระดับหนึ่ง ส
